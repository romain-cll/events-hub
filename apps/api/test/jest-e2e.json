{
  "moduleFileExtensions": [
    "js",
    "mjs",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 4,
  "setupFiles": [
    "<rootDir>/jest.setup.ts"
  ],
  "transform": {
    "^.+\\.m?[tj]s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(better-auth|@noble|jose|kysely|nanostores|rou3))"
  ]
}
