# Postgres local (installeur EDB — binaires dans /Library/PostgreSQL/17/bin).
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE
DATABASE_URL=postgresql://user_events_hub:motdepasse@localhost:5432/events_hub

# Port HTTP de l'API
PORT=3003

# Secret maître du hachage visiteur (HMAC). Doit être long et aléatoire :
#   openssl rand -hex 32
# Le changer invalide toutes les clés visiteur — les événements passés
# deviennent définitivement non regroupables entre eux.
VISITOR_KEY_SECRET=remplace-moi-par-un-secret-aleatoire

# Secret de signature des sessions Better Auth. Long et aléatoire :
#   openssl rand -hex 32
# Le changer déconnecte tout le monde — les cookies de session existants
# deviennent invérifiables.
BETTER_AUTH_SECRET=remplace-moi-par-un-secret-aleatoire

# Origine du dashboard. C'est la seule à laquelle l'API accepte d'envoyer des
# cookies (CORS credentialé). L'ingestion, elle, reste ouverte à toutes.
WEB_URL=http://localhost:3002

# Base publique de l'API : Better Auth s'en sert pour construire les liens
# qu'il met dans les emails.
API_URL=http://localhost:3003

# Base GeoIP (DB-IP City Lite, format mmdb) : résout l'IP en pays/région/ville
# à l'ingestion. Le fichier pèse ~124 Mo, il n'est donc pas dans le dépôt —
# à télécharger sur https://db-ip.com/db/download/ip-to-city-lite et à poser
# dans apps/api/data/ (dossier gitignoré).
# Absente, la géolocalisation est simplement désactivée : l'API démarre et
# ingère normalement, les sessions n'ont juste pas de pays.
GEOIP_DB_PATH=./data/dbip-city-lite-2026-08.mmdb

# Nombre de reverse proxies devant l'API. Détermine quelle adresse de
# `X-Forwarded-For` est crue comme étant celle du visiteur.
# ⚠️ Ne jamais mettre autre chose qu'un entier correspondant à la réalité du
# déploiement : trop haut, un client peut forger son IP — donc sa clé visiteur
# et son pays — en écrivant l'en-tête lui-même. 0 ou absent = on ne croit rien,
# et c'est le bon réglage en local.
TRUST_PROXY_HOPS=0

# Purge planifiée des données de plus de 25 mois (03:15 UTC, tous les jours).
# Activée par défaut ; `false` la désactive.
#
# Le seul réglage de la rétention, et il ne gouverne **que** le déclenchement
# planifié. La durée, elle, est une constante du code (`RETENTION_MONTHS`) :
# une politique destructrice et irréversible n'a pas à pouvoir être changée par
# une variable d'environnement, où un `1` posé par erreur effacerait deux ans
# d'historique sans qu'aucun diff ne l'ait montré.
#
# À mettre à `false` sur les instances qui ne doivent pas purger — une réplique
# de lecture, un bac à sable branché sur une copie de production. Le verrou
# consultatif rend déjà l'exécution concurrente inoffensive : plusieurs API sur
# la même base peuvent toutes l'avoir à `true`.
RETENTION_ENABLED=true

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Les trois sont optionnelles : sans elles, l'API démarre et ingère normalement,
# seule la connexion d'un compte Stripe est refusée — avec un message clair, et
# un avertissement au démarrage. C'est l'inverse de VISITOR_KEY_SECRET, qui est
# chargé à chaque événement et sans lequel rien n'a de sens.

# Notre clé plateforme (`sk_…`), depuis notre propre compte Stripe. Elle sert à
# l'échange OAuth, à tous les appels faits au nom d'un compte connecté (avec
# l'en-tête `Stripe-Account`), et à signer le `state` du flux d'autorisation.
# ⚠️ Un vrai secret : elle ne quitte jamais le serveur.
STRIPE_SECRET_KEY=sk_test_remplace-moi

# L'identifiant de la plateforme dans Connect (`ca_…`), à récupérer sur
# https://dashboard.stripe.com/settings/connect/onboarding-options/oauth
# Il n'est pas secret : il voyage dans l'URL d'autorisation.
# ⚠️ L'URL de retour doit y être déclarée, sinon Stripe refuse la redirection :
# WEB_URL + /integrations/stripe/callback
STRIPE_CONNECT_CLIENT_ID=ca_remplace-moi

# La portée demandée à Connect : `read_only` (défaut) ou `read_write`.
#
# `read_only` est la cible — le hub lit des paiements, il n'en crée aucun, et
# ça nous met hors d'état de casser quoi que ce soit chez un client.
#
# ⚠️ Stripe ne l'accorde pas d'office : sans démarche auprès de leur support,
# l'autorisation échoue avec « Please use the `read_write` scope, or contact
# support in order to use read-only connections ». En attendant, `read_write`
# est la seule portée disponible.
#
# Ce que `read_write` coûte, au-delà du principe : la restriction de juin 2021
# s'y applique, donc un compte Standard déjà contrôlé par une autre plateforme
# devient impossible à connecter.
STRIPE_CONNECT_SCOPE=read_write

# Le secret de signature des webhooks (`whsec_…`). Sans lui, n'importe qui peut
# poster de faux paiements sur la route de webhook et fabriquer du revenu.
# En local, `stripe listen` en affiche un à chaque démarrage.
STRIPE_WEBHOOK_SECRET=whsec_remplace-moi
